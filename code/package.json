{
  "name": "endorphin-ai",
  "version": "1.1.1",
  "description": "E2E Testing Reinvented with AI - A powerful TypeScript browser automation framework using AI-powered testing with LangChain, OpenAI GPT-4o, and Playwright",
  "main": "dist/framework/index.js",
  "bin": {
    "endorphin": "dist/bin/endorphin.js",
    "endorphin-ai": "dist/bin/endorphin.js"
  },
  "type": "module",
  "scripts": {
    "start": "tsx framework/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --passWithNoTests dev-tests/development/unit",
    "test:integration": "jest --passWithNoTests --coverage=false dev-tests/development/integration",
    "test:critical": "jest --passWithNoTests --coverage=false --testTimeout=180000 dev-tests/development/integration/critical",
    "test:dev": "jest --selectProjects='Development Tests'",
    "test:all": "jest --selectProjects='Development Tests'",
    "test:package": "cd dev-tests/package-tests && ./run-all-tests.sh",
    "test:node-22": "echo 'Testing Node.js compatibility...' && node --version && npm test && npm run test:package",
    "test:node-24": "echo 'Testing Node.js 24 LTS compatibility...' && node --version && npm test && npm run test:package",
    "build": "tsc && node scripts/fix-imports.js && node scripts/post-build.js",
    "build:watch": "tsc --watch",
    "pack:local": "npm run build && npm pack --pack-destination dist",
    "test:local": "npm run pack:local && ./dev-tests/package-tests/run-all-tests.sh",
    "test:install": "npm run build && ./scripts/test-npm-install.sh",
    "type-check": "tsc --noEmit",
    "playground:test": "cd playground && tsx ../bin/endorphin.ts run test",
    "playground:list": "cd playground && tsx ../bin/endorphin.ts list",
    "test-recorder": "tsx framework/test-recorder/index.ts",
    "lint": "eslint . --ext .js,.mjs,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.mjs,.ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "npm run lint && npm run format:check",
    "quality:fix": "npm run lint:fix && npm run format",
    "build:clean": "rm -rf dist && npm run build",
    "dev": "tsx",
    "cleanup": "./scripts/cleanup-test-artifacts.sh",
    "postinstall": "node scripts/postinstall.js",
    "endorphin": "endorphin",
    "endorphin-ai": "endorphin-ai",
    "endorphin:init": "endorphin init",
    "endorphin:version": "endorphin --version",
    "endorphin:help": "endorphin --help",
    "endorphin-ai:init": "endorphin init",
    "endorphin-ai:version": "endorphin --version",
    "endorphin-ai:help": "endorphin --help",
    "precommit": "echo 'Pre-commit hooks disabled temporarily'",
    "prepublishOnly": "npm run build && npm run test:unit"
  },
  "keywords": [
    "ai",
    "testing",
    "e2e",
    "automation",
    "browser",
    "playwright",
    "langchain",
    "openai",
    "gpt-4",
    "test-framework",
    "typescript",
    "type-safe",
    "endorphin-ai",
    "endorphin"
  ],
  "author": "Andrew Novykov <iam@andrewnovykov.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endorphin-ai/endorphin-ai.git",
    "directory": "code"
  },
  "homepage": "https://github.com/endorphin-ai/endorphin-ai#readme",
  "bugs": {
    "url": "https://github.com/endorphin-ai/endorphin-ai/issues"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "files": [
    "dist/",
    "scripts/",
    "README.md",
    "LICENSE.md",
    "MIGRATION-GUIDE.md"
  ],
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@langchain/community": "^1.1.15",
    "@langchain/core": "^1.1.24",
    "@langchain/google-genai": "^2.1.18",
    "@langchain/langgraph": "^1.1.4",
    "dotenv": "^16.4.7",
    "langchain": "^1.2.24",
    "openai": "^4.104.0",
    "playwright": "^1.58.2",
    "tsx": "^4.21.0",
    "zod": "^3.25.76"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@jest/globals": "^30.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.3",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "endorphin-ai": "^1.0.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.2.0",
    "jest-environment-node": "^30.2.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "typescript-transform-paths": "^3.5.6"
  },
  "types": "./dist/framework/index.d.ts"
}
