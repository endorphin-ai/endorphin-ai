# 🔑 Required: OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# 🐛 Debug Settings
ENDORPHIN_DEBUG=false
# Set to 'verbose' for detailed logging, 'true' for basic debug info

# 🌐 Browser Settings
HEADLESS=false
# Set to 'true' to run tests without browser UI (faster)

BASE_URL=https://example.com
# Default URL for tests (can be overridden per test)

# 📊 JIRA Integration (Optional)
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=TEST

# 🎯 Test Configuration
TEST_TIMEOUT=30000
# Default timeout for test operations (milliseconds)

MAX_RETRIES=3
# Number of retries for failed operations

# 📸 Screenshot Settings
SCREENSHOTS_ENABLED=true
# Enable/disable screenshot capture during tests

# 🎬 Video Recording
RECORD_VIDEO=false
# Enable video recording (requires additional setup)

# 📈 Performance Monitoring
ENDORPHIN_PERF_MONITORING=false
# Enable performance monitoring and metrics collection

# 🧠 Memory Optimization
ENDORPHIN_MEMORY_OPTIMIZER=false
# Enable memory optimization for large test suites

# 🖼️ Image Processing
ENDORPHIN_DISABLE_IMAGES=false
# Disable image loading for faster test execution
